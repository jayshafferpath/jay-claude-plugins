# Jira Cloud credentials (required)
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-api-token
JIRA_DOMAIN=your-org.atlassian.net

# Dev root — parent directory containing all your repo clones (required for queue mode)
DEV_ROOT=/path/to/your/dev/directory

# Slack webhook (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/triggers/...

# Dashboard port (optional, defaults to 3789)
# DASHBOARD_PORT=3789

# Let the dashboard RUN lifecycle commands, not just suggest them (optional).
#
# Off by default, and deliberately an env var rather than a UI toggle: the
# commands it unlocks (/cleanup-main, /cleanup-feature, /promote-to-main) delete
# remote branches and transition Jira, and a toggle in a browser tab is too easy
# to leave on. With this unset, the dashboard still shows the command for every
# ticket — as copy-to-clipboard only.
#
# Runs are headless `claude -p` sessions, so they pass --yes and nobody reviews
# the plan first. Enable only if you want that.
# DASHBOARD_ALLOW_ACTIONS=true
